generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubjectName {
  DBMS
  OS
  CN
  OOPS
}

enum Platform {
  LEETCODE
  CODEFORCES
  HACKERRANK
}

model User {
  id                String                 @id @default(cuid())
  name              String
  email             String                 @unique
  password          String
  avatarUrl         String?
  role              String                 @default("student")
  bio               String?
  targetRole        String?
  university        String?
  githubUrl         String?
  portfolioUrl      String?
  themePreference   String                 @default("dark")
  selectedSubjects  String[]               @default([])
  onboardingDuration String?
  onboardingIntensity String?
  onboardingCompleted Boolean              @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  dsaTopics         DsaTopic[]
  codingProblems    CodingProblem[]
  subjectProgress   SubjectProgress[]
  aptitudeResults   AptitudePerformance[]
  goals             Goal[]
  analyticsSnaps    AnalyticsSnapshot[]
  mockInterviews    MockInterview[]
  resumeAnalyses    ResumeAnalysis[]
}

model DsaTopic {
  id               String   @id @default(cuid())
  userId           String
  name             String
  category         String
  difficulty       Difficulty @default(MEDIUM)
  completed        Boolean   @default(false)
  revisionCount    Int       @default(0)
  weakSpot         Boolean   @default(false)
  notes            String?
  completion       Int       @default(0)
  lastPracticedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model CodingProblem {
  id             String    @id @default(cuid())
  userId         String
  platform       Platform
  title          String
  difficulty     Difficulty @default(MEDIUM)
  tags           String[]
  timeTakenMin   Int       @default(0)
  revisionNeeded Boolean   @default(false)
  submissionDate DateTime   @default(now())
  notes          String?
  solved         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
}

model SubjectProgress {
  id               String       @id @default(cuid())
  userId           String
  subject          String
  topic            String
  completed        Boolean      @default(false)
  confidenceMeter  Int          @default(0)
  revisionCount    Int          @default(0)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
}

model Topic {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  title       String
  status      String   @default("todo")
  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
}

model PracticeEntry {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  date        DateTime @default(now())
  count       Int      @default(0)
  correct     Int      @default(0)
  tags        String[] @default([])
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject, date])
}

model MockInterviewEntry {
  id                 String   @id @default(cuid())
  userId             String
  subject            String
  company            String?
  questionsAttempted Int      @default(0)
  completed          Boolean  @default(false)
  score              Int      @default(0)
  notes              String?
  scheduledFor       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
}

model Flashcard {
  id           String   @id @default(cuid())
  userId       String
  subject      String
  front        String
  back         String
  reviewedAt   DateTime?
  reviewedCount Int     @default(0)
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
}

model AptitudePerformance {
  id             String   @id @default(cuid())
  userId         String
  category       String
  accuracy       Int      @default(0)
  speed          Int      @default(0)
  mockScore      Int      @default(0)
  attempted     Int      @default(0)
  correct        Int      @default(0)
  notes          String?
  takenAt        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

model Goal {
  id             String   @id @default(cuid())
  userId         String
  title          String
  description    String?
  dueDate        DateTime?
  progress       Int      @default(0)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AnalyticsSnapshot {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  readinessScore   Int      @default(0)
  totalSolved      Int      @default(0)
  streak           Int      @default(0)
  weeklyConsistency Int     @default(0)
  subjectRadar     Json?
  heatmap          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model MockInterview {
  id             String   @id @default(cuid())
  userId         String
  company        String
  score          Int      @default(0)
  feedback       String?
  scheduledFor   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeAnalysis {
  id             String   @id @default(cuid())
  userId         String
  score          Int      @default(0)
  summary        String?
  improvement    String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}